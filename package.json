{
  "name": "apple-store-pickup-assistant",
  "version": "0.2.0",
  "private": true,
  "description": "Apple 直营店自提购买助手 — C-002 离线演练纵向切片（仅模拟，不访问苹果官网）",
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "rehearse": "node src/cli.ts rehearse --scenario refuse-then-accept",
    "scenarios": "node src/cli.ts scenarios",
    "bench": "node src/cli.ts bench --runs 200 --warmup 20 --seed 1",
    "test": "node --test \"test/*.test.ts\" \"review/*.test.ts\"",
    "test:impl": "node --test \"test/*.test.ts\"",
    "test:review": "node --test \"review/*.test.ts\""
  }
}
